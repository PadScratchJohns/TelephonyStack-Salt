# RTPengine manage functions for call recording based on an "X-Recording=" header. 
    def ksr_route_rtpengine(self, msg):
        if KSR.hdr.is_present("X-Recording") > 0:
            if KSR.textops.has_body_type("application/sdp") > 0 :
# Conditional statement to check for the header value
                if str(KSR.pv.get("$(hdr(X-Recording))")).find("Start") == 0:
                    KSR.rtpengine.start_recording()
                    KSR.xlog.xlog("L_INFO", "RTPengine Recording ON - handling Block - CallID %s source %s received %s" % (KSR.pv.get("$ci"), KSR.pv.get("$si"), KSR.pv.get("$Ri")))
                elif str(KSR.pv.get("$(hdr(X-Recording))")).find("Stop") == 0:
                    KSR.rtpengine.stop_recording("pause")
                    KSR.xlog.xlog("L_INFO", "RTPengine Recording PAUSED - handling Block - CallID %s source %s received %s" % (KSR.pv.get("$ci"), KSR.pv.get("$si"), KSR.pv.get("$Ri")))
# If it has a header, but the value is not on/off - error out here and process the call with no recording.
                else:
                    KSR.xlog.xlog("L_ERR", "RTPengine Recording ERROR - handling Block - CallID %s source %s received %s" % (KSR.pv.get("$ci"), KSR.pv.get("$si"), KSR.pv.get("$Ri")))
# Blocking RFC4733 DTMF (events and in-band) both directions - for recorded calls only - handle media normally. 
# This is here so if DTMF are pressed whilst the call is recording they are dropped so no PCI_DSS breach can happen - TODO - JH - Check if this is needed. 
                #KSR.rtpengine.block_dtmf()
                KSR.rtpengine.rtpengine_manage("RTP/AVP replace-session-connection replace-origin port-latching ICE=remove direction=public ")
# No header - RECORDS ALL - this is a stop gap until the above is in and then just remove the "KSR.rtpengine.start_recording()" from the below 
        else:
            if KSR.textops.has_body_type("application/sdp") > 0 :
                KSR.rtpengine.start_recording() # remove this after the logic for start/stop is in
                KSR.rtpengine.rtpengine_manage("RTP/AVP replace-session-connection replace-origin port-latching ICE=remove direction=public ")
                KSR.xlog.xlog("L_INFO", "RTPengine handling Block - CallID %s source %s received %s" % (KSR.pv.get("$ci"), KSR.pv.get("$si"), KSR.pv.get("$Ri")))
        return 1
# Port cleanup
    def ksr_send_reply_clear_rtpengine(self, msg, code:int, reason:str):
        KSR.sl.sl_send_reply(code, reason)
        if KSR.is_method_in("I"):
            KSR.xlog.xlog("L_INFO", "clearing rtpengine resource after generating %d for call-id %s" % (code, KSR.pv.get("$ci")))
            KSR.rtpengine.rtpengine_manage("")
{% endif %}

