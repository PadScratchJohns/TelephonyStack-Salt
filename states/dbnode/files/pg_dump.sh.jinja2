{% set role = salt['grains.get']('roles') %}
{% set ins = salt['grains.get']('instance') %}
#!/bin/bash
# Retention is done at blob/container level - 14 days
# cron job governs the frequency - every 1 hour
# Linked blob is under /pg/backups/ dir so placing directly into this helps keep the complexity down too. 

# SQL of the backup_user - you need to add the privileges for each DB
